{
  "name": "@charm-ux/theming",
  "version": "0.5.0",
  "description": "Design token system with type-safe helpers and CSS generation for Charm UI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js"
    },
    "./lit": {
      "types": "./dist/lit/index.d.ts",
      "import": "./dist/lit/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "demo": "node ./demo/generators.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "design-tokens",
    "theming",
    "css-variables",
    "design-system",
    "color",
    "generator"
  ],
  "author": "Charm UX Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/charm-ux/core.git",
    "directory": "packages/theming"
  },
  "bugs": {
    "url": "https://github.com/charm-ux/core/issues"
  },
  "homepage": "https://github.com/charm-ux/core/packages/theming#readme",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "dependencies": {
    "culori": "^4.0.0"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "lit": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
